{
  "mcpServers": {
    "taskrail": {
      "command": "cargo",
      "args": [
        "run",
        "--quiet",
        "--package",
        "taskrail",
        "--",
        "mcp"
      ],
      "env": {
        "TASKRAIL_MCP_PROFILE": "public"
      },
      "cwd": "."
    },
    "taskrail-fleet": {
      "command": "cargo",
      "args": [
        "run",
        "--quiet",
        "--package",
        "taskrail",
        "--",
        "mcp-fleet",
        "--config",
        "./examples/fleet.yaml"
      ],
      "cwd": "."
    }
  }
}
